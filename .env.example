# Mutable files belong outside Git; change only when the default runtime path is unsuitable.
XHS_RUNTIME_DIR=D:\AI_WORKSPACE_RUNTIME\xhs-intelligence-workbench
XHS_DATABASE_PATH=
XHS_ADB_EXECUTABLE=adb
XHS_BROWSER_EXECUTABLE=
XHS_QIANFAN_BROWSER_PROFILE_DIR=
XHS_QIANFAN_TIMEOUT_SECONDS=10
# Interpreter whose installed xhs-cli sources exactly match pinned commit 3ce7141.
XHS_CLI_PYTHON_EXECUTABLE=C:\Path\To\Python312\python.exe
# Must be a non-reparse path inside XHS_RUNTIME_DIR. Prepare .xhs-cli/cookies.json externally; hardlinks are rejected.
XHS_CLI_STATE_DIR=D:\AI_WORKSPACE_RUNTIME\xhs-intelligence-workbench\xhs-cli-state
XHS_CLI_TIMEOUT_SECONDS=20
XHS_CLI_MAX_OUTPUT_BYTES=5242880
BAILIAN_API_KEY=
XHS_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XHS_BAILIAN_TEXT_MODEL=deepseek-v4-flash
XHS_BAILIAN_MAX_ATTEMPTS=3
XHS_BAILIAN_TIMEOUT_SECONDS=60
XHS_ARTIFACT_CLEANUP_POLL_SECONDS=30
XHS_ARTIFACT_CLEANUP_BATCH_SIZE=10
XHS_ARTIFACT_CLEANUP_GRACE_HOURS=24
